<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Placeholder tab. Replace with the real Lead Scoring fields when the feature ships. -->
    <record id="crm_lead_view_form_smarterp" model="ir.ui.view">
        <field name="name">crm.lead.form.smarterp</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="SmartERP" name="smarterp">
                    <div class="alert alert-info" role="status">
                        <strong>Lead Scoring</strong> will appear here. Target date: Nov 19, 2026.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
